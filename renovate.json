{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "matchPackageNames": ["python"],
      "allowedVersions": "<3.15.0" 
    },
    {
      "matchDepNames": ["python"],
      "ignoreUnstable": true
    }
  ]
}